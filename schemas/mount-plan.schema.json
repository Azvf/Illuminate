{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Illuminate Mount Plan",
  "type": "object",
  "required": ["schema_version", "session_id", "repo", "harness", "packs", "policies", "skills"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "session_id": { "type": "string" },
    "repo": { "type": "string" },
    "harness": { "type": "string", "enum": ["claude-code"] },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "policies": { "type": "array", "items": { "type": "string" } },
    "skills": {
      "type": "object",
      "properties": {
        "exposed": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
