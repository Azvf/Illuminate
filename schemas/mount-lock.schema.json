{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Illuminate Mount Lock",
  "type": "object",
  "required": ["schema_version", "session_id", "created_at", "files", "pack_lock_hash"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "session_id": { "type": "string" },
    "created_at": { "type": "string", "description": "ISO 8601 timestamp" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "pack_lock_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
