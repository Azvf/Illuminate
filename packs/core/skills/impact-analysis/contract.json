{
  "schema_version": 1,
  "id": "illuminate.impact-analysis",
  "version": "1.0.0",
  "entry": "SKILL.md",

  "activation": {
    "mode": "auto",
    "include_tags": [
      "change.cross-module",
      "change.cross-layer",
      "api.modify",
      "core-path.modify",
      "regression.risk"
    ],
    "exclude_tags": [
      "documentation.only",
      "configuration.only"
    ]
  },

  "requirements": {
    "required_artifacts": [],
    "preferred_artifacts": [
      "test_suite"
    ],
    "commands": [
      "git",
      "grep"
    ]
  },

  "permissions": {
    "read": [
      "repository/**"
    ],
    "write": [
      ".illuminate/reports/**"
    ],
    "execute": [
      "grep",
      "rg"
    ]
  },

  "relations": {
    "recommended_next": [],
    "activation_conflicts": []
  },

  "outputs": [
    "direct_impact_table",
    "indirect_impact_graph",
    "regression_risk_table",
    "scope_minimization_confirmation"
  ],

  "project_context": {
    "candidates": [
      "AGENTS.md",
      "CLAUDE.md",
      "CONTRIBUTING.md",
      "docs/README-HUMAN.md",
      "docs/human-docs.json",
      "docs/20-components/*.md",
      "docs/30-modules/*.md",
      "docs/40-journeys/*.md",
      "docs/70-metadata/**/*.yaml"
    ],
    "required": false
  }
}
