{
  "schema_version": 1,
  "id": "illuminate.archive-module-doc",
  "version": "1.0.0",
  "entry": "SKILL.md",

  "activation": {
    "mode": "explicit-preferred",
    "include_tags": [
      "module-doc.archive",
      "module-doc.split",
      "module-doc.structure",
      "module-doc.index"
    ],
    "exclude_tags": [
      "project-wide-doc-cleanup",
      "new-knowledge-record",
      "unverified-module-analysis"
    ]
  },

  "requirements": {
    "required_artifacts": [
      "module_identity",
      "existing_verified_knowledge"
    ],
    "preferred_artifacts": [
      "module_source_root",
      "existing_framework_owner"
    ]
  },

  "permissions": {
    "read": [
      "repository/**"
    ],
    "write": [
      "docs/Framework/**",
      "docs/文档索引.md"
    ],
    "execute": [
      "git diff",
      "rg"
    ]
  },

  "relations": {
    "recommended_previous": [
      "illuminate.record-knowledge"
    ],
    "recommended_next": [
      "illuminate.tidy-doc"
    ]
  },

  "project_context": {
    "candidates": [
      "docs/Framework/**/*.md"
    ],
    "required": false
  },

  "outputs": [
    "module_scope",
    "archive_mode",
    "document_map",
    "migrated_facts",
    "unresolved_facts",
    "removed_duplicates",
    "validation_result"
  ]
}
