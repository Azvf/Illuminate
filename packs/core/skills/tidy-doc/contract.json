{
  "schema_version": 1,
  "id": "illuminate.tidy-doc",
  "version": "1.1.0",
  "entry": "SKILL.md",

  "activation": {
    "mode": "auto",
    "include_tags": [
      "documentation.cleanup",
      "documentation.align",
      "index.fix",
      "stale-reference.fix"
    ],
    "exclude_tags": []
  },

  "requirements": {
    "required_artifacts": [],
    "preferred_artifacts": [],
    "commands": [
      "git",
      "grep",
      "rg",
      "python"
    ]
  },

  "permissions": {
    "read": [
      "repository/**"
    ],
    "write": [
      "AGENTS.md",
      "docs/20-components/**",
      "docs/30-modules/**",
      "docs/40-journeys/**",
      "docs/README-HUMAN.md",
      "docs/human-docs.json",
      "docs/Guidelines/**",
      "docs/Framework/**",
      "docs/Development/**",
      "packs/core/skills/**"
    ],
    "execute": [
      "grep",
      "rg",
      "python"
    ]
  },

  "relations": {
    "recommended_next": [],
    "activation_conflicts": []
  },

  "project_context": {
    "candidates": [
      "README-HUMAN.md",
      "human-docs.json",
      "20-components/**/*.md",
      "30-modules/**/*",
      "40-journeys/**/*.md",
      "**/verification/*.yaml",
      "Guidelines/**/*.md",
      "Framework/**/*.md",
      "Development/**/*.md"
    ],
    "required": false
  },

  "outputs": [
    "tidied_documents",
    "misleading_issues_fixed",
    "meta_narrative_removed",
    "mermaid_render_issues_fixed",
    "remaining_residue_report"
  ]
}
