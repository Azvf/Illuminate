{
  "schema_version": 1,
  "id": "illuminate.archive-module-doc",
  "version": "1.0.0",
  "entry": "SKILL.md",

  "activation": {
    "mode": "explicit",
    "include_tags": [
      "module-doc.archive",
      "module-doc.split",
      "module-doc.structure",
      "module-doc.index"
    ],
    "exclude_tags": [
      "project-wide-doc-cleanup",
      "new-knowledge-record",
      "unverified-module-analysis"
    ]
  },

  "requirements": {
    "required_artifacts": [
      "module_identity",
      "existing_verified_knowledge"
    ],
    "preferred_artifacts": [
      "module_source_root",
      "existing_framework_owner",
      "verification_metadata",
      "doc_refs"
    ]
  },

  "permissions": {
    "read": [
      "repository/**"
    ],
    "write": [
      "docs/20-components/*.md",
      "docs/30-modules/*.md",
      "docs/40-journeys/*.md",
      "docs/70-metadata/**",
      "docs/文档索引.md"
    ],
    "execute": [
      "git diff",
      "rg"
    ]
  },

  "relations": {
    "recommended_previous": [
      "illuminate.record-knowledge"
    ],
    "recommended_next": [
      "illuminate.tidy-doc"
    ],
    "activation_conflicts": []
  },

  "project_context": {
    "candidates": [
      "docs/20-components/*.md",
      "docs/30-modules/*.md",
      "docs/40-journeys/*.md",
      "docs/70-metadata/**/*.yaml",
      "docs/README-HUMAN.md",
      "docs/human-docs.json"
    ],
    "required": false
  },

  "outputs": [
    "module_scope",
    "archive_mode",
    "document_map",
    "migrated_facts",
    "unresolved_facts",
    "removed_duplicates",
    "validation_result"
  ]
}
