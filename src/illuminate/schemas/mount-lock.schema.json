{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Illuminate Mount Lock",
  "type": "object",
  "required": ["schema_version", "session_id", "created_at", "files", "pack_lock_hash"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "session_id": { "type": "string" },
    "created_at": { "type": "string", "description": "ISO 8601 timestamp" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "pack_lock_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "declared_permissions": { "type": "object" },
    "enforced_permissions": { "type": "object" },
    "unsupported_permissions": { "type": "object" },
    "enforcement_status": { "type": "object" },
    "exposed_skills": { "type": "array", "items": { "type": "string" } },
    "file_count": { "type": "integer" },
    "external_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "harness": { "type": "string" },
    "pack": {
      "type": "object",
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "target": { "type": "object" },
    "selection": { "type": "object" },
    "managed_artifacts": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "object" }
  }
}
